# ==============================================================================
# KUKKIWON CUP CHAMPIONSHIP - ENVIRONMENT CONFIGURATION TEMPLATE
# Collaboration: Kukkiwon North India x Kyorix Sports Technology
# Standalone Independent Platform - Do NOT connect to legacy Kyorix website
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Direct or pooled PostgreSQL connection string
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Direct connection (used by Prisma migrations if using transaction pooling)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 2. SUPABASE CREDENTIALS (Authentication & Storage)
# ------------------------------------------------------------------------------
# Public Supabase project URL (safe for browser)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"

# Supabase Anonymous Key (safe for browser client-side operations)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role Key (SERVER-ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 3. APPLICATION & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# The canonical public URL used for QR verification links and absolute redirects
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Application environment: development | staging | production
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secret key used for signing internal JWT tokens, sessions, and QR verification signatures
# Generate a strong 64-character secret using: openssl rand -base64 48
JWT_SECRET="replace-with-a-secure-random-64-character-secret-string"

# Admin setup token / root bootstrap secret (used only for initial migration seeding)
ADMIN_BOOTSTRAP_SECRET="replace-with-a-secure-bootstrap-secret"

# Session expiration duration (e.g., 7d, 24h)
AUTH_SESSION_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 5. STORAGE CONFIGURATION (Buckets & Privacy)
# ------------------------------------------------------------------------------
# Storage provider: 'supabase' (production) or 'local' (local development)
STORAGE_PROVIDER="local"

# Storage Bucket Names
STORAGE_BUCKET_DOCUMENTS="participant-documents"
STORAGE_BUCKET_PHOTOS="participant-photos"
STORAGE_BUCKET_ASSETS="championship-assets"
STORAGE_BUCKET_ID_CARDS="id-cards"

# Signed URL expiration in seconds for private documents (e.g., 300 = 5 minutes)
STORAGE_SIGNED_URL_EXPIRY_SECONDS=300

# ------------------------------------------------------------------------------
# 6. PAYMENT GATEWAY (Razorpay / Stripe)
# ------------------------------------------------------------------------------
# Active payment gateway provider: 'RAZORPAY' | 'STRIPE' | 'MOCK'
PAYMENT_GATEWAY_PROVIDER="RAZORPAY"

# Razorpay Key ID (public key can be used in checkout popup)
NEXT_PUBLIC_PAYMENT_KEY_ID="rzp_test_..."

# Razorpay Secret Key (SERVER-ONLY - for webhook & signature verification)
PAYMENT_KEY_SECRET="your-razorpay-secret-key"

# Payment Webhook Secret (used to verify incoming server webhooks)
PAYMENT_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# ------------------------------------------------------------------------------
# 7. EMAIL & NOTIFICATIONS
# ------------------------------------------------------------------------------
# Resend / SendGrid / SMTP API key (SERVER-ONLY)
EMAIL_API_KEY="re_..."
EMAIL_FROM_ADDRESS="no-reply@kukkiwoncup.com"
EMAIL_FROM_NAME="Kukkiwon Cup Championship"

# ------------------------------------------------------------------------------
# 8. KYORIX INTEGRATION (Scoring & Bracket System Sync)
# ------------------------------------------------------------------------------
# Enable or disable automated synchronization with Kyorix scoring system
KYORIX_INTEGRATION_ENABLED="false"
# API base URL for Kyorix service (must use HTTPS in production)
KYORIX_API_BASE_URL="https://api.kyorix.com/v1"
# Kyorix API credentials (SERVER-ONLY)
KYORIX_API_KEY="kyorix_live_key_..."
KYORIX_API_SECRET="kyorix_live_secret_..."
# Webhook verification secret for incoming Kyorix notifications (SERVER-ONLY)
KYORIX_WEBHOOK_SECRET="kyorix_webhook_secret_..."
KYORIX_REQUEST_TIMEOUT_MS="10000"
KYORIX_USE_MOCK="false"

# ------------------------------------------------------------------------------
# 9. PRODUCTION INITIAL SUPER_ADMIN BOOTSTRAP (CLI Only)
# ------------------------------------------------------------------------------
# Used by scripts/bootstrap-admin.mjs to initialize initial root admin.
# Do NOT store production admin passwords here; pass via environment in deployment pipeline.
ADMIN_BOOTSTRAP_EMAIL="superadmin@kukkiwoncup.org"
ADMIN_BOOTSTRAP_PASSWORD=""
ADMIN_BOOTSTRAP_NAME="Kukkiwon Cup Super Administrator"

# ------------------------------------------------------------------------------
# 10. AUDIT & LOGGING
# ------------------------------------------------------------------------------
LOG_LEVEL="info"
