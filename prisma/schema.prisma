// ==============================================================================
// KUKKIWON CUP CHAMPIONSHIP - DATABASE SCHEMA
// Standalone relational architecture for Kukkiwon North India x Kyorix Sports Technology
// Database: PostgreSQL / Supabase PostgreSQL
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum ChampionshipStatus {
  DRAFT
  UPCOMING
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  ONGOING
  COMPLETED
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ParticipantType {
  ATHLETE
  COACH
  ACADEMY_TEAM
}

enum ParticipantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RegistrationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  PENDING_PAYMENT
  PAYMENT_FAILED
  PAID
  CONFIRMED
  APPROVED
  REJECTED
  CANCELLED
}

enum DocumentVerificationStatus {
  NOT_REQUIRED
  NOT_UPLOADED
  PENDING
  UPLOADED
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentOrderStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum IdCardStatus {
  NOT_ELIGIBLE
  READY
  NOT_GENERATED
  GENERATED
  REVOKED
  REISSUED
}

enum AdminRole {
  SUPER_ADMIN
  EVENT_ADMIN
  REGISTRATION_ADMIN
  FINANCE_ADMIN
  DOCUMENT_ADMIN
  CONTENT_ADMIN
  VIEWER
}

// ------------------------------------------------------------------------------
// 1. REGISTRANT / USER ACCOUNTS (Phase 3 Authentication)
// ------------------------------------------------------------------------------
model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique @db.VarChar(255)
  password_hash String         @db.VarChar(255)
  full_name     String         @db.VarChar(255)
  phone         String?        @db.VarChar(50)
  role          String         @default("REGISTRANT") @db.VarChar(50)
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime       @updatedAt @db.Timestamptz(6)

  // Relationships
  registrations  Registration[]
  academies      Academy[]        @relation("AcademyManager")
  participants   Participant[]
  audit_logs     AuditLog[]
  payment_orders PaymentOrder[]
  invoices       PaymentInvoice[]

  @@index([email])
  @@map("users")
}

// ------------------------------------------------------------------------------
// 2. CHAMPIONSHIPS (Multi-Championship Scalable Architecture)
// ------------------------------------------------------------------------------
model Championship {
  id                 String             @id @default(uuid()) @db.Uuid
  slug               String             @unique @db.VarChar(100)
  name               String             @db.VarChar(255)
  short_name         String?            @db.VarChar(50)
  subtitle           String?            @db.VarChar(255)
  description        String?            @db.Text
  status             ChampionshipStatus @default(DRAFT)
  start_date         DateTime           @db.Timestamptz(6)
  end_date           DateTime           @db.Timestamptz(6)
  venue              String             @db.VarChar(255)
  city               String             @db.VarChar(100)
  state              String             @db.VarChar(100)
  country            String             @default("India") @db.VarChar(100)
  registration_open  DateTime           @db.Timestamptz(6)
  registration_close DateTime           @db.Timestamptz(6)
  
  // Financial & Registration Rules
  currency           String             @default("INR") @db.VarChar(10)
  entry_fee_athlete  Decimal            @default(0.00) @db.Decimal(10, 2)
  entry_fee_coach    Decimal            @default(0.00) @db.Decimal(10, 2)
  entry_fee_official Decimal            @default(0.00) @db.Decimal(10, 2)
  
  // Media & Assets
  banner_url         String?            @db.Text
  poster_url         String?            @db.Text
  rules_document_url String?            @db.Text
  
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  updated_at         DateTime           @updatedAt @db.Timestamptz(6)

  // Relationships
  registrations         Registration[]
  categories            Category[]
  document_requirements DocumentRequirement[]
  registration_fees     RegistrationFee[]
  site_settings         SiteSetting?
  terms_versions        TermsVersion[]
  content_config        ChampionshipContent?
  announcements         ChampionshipAnnouncement[]
  important_dates       ChampionshipImportantDate[]
  faqs                  ChampionshipFAQ[]

  @@index([slug])
  @@index([status])
  @@index([start_date, end_date])
  @@map("championships")
}

// ------------------------------------------------------------------------------
// 3. ACADEMIES / TEAMS (Organization Directory)
// ------------------------------------------------------------------------------
model Academy {
  id                     String         @id @default(uuid()) @db.Uuid
  code                   String         @unique @db.VarChar(60) // e.g. KKC26-ACA-0001
  name                   String         @db.VarChar(255)
  short_name             String?        @db.VarChar(50)
  country                String         @default("India") @db.VarChar(100)
  state                  String         @db.VarChar(100)
  city                   String         @db.VarChar(100)
  address                String?        @db.Text
  email                  String?        @db.VarChar(255)
  phone                  String?        @db.VarChar(50)
  website                String?        @db.VarChar(255)
  logo_url               String?        @db.Text
  head_coach_name        String?        @db.VarChar(255)
  
  // Representative details
  representative_name    String?        @db.VarChar(255)
  representative_email   String?        @db.VarChar(255)
  representative_phone   String?        @db.VarChar(50)
  representative_role    String?        @db.VarChar(100)
  
  status                 String         @default("APPROVED") @db.VarChar(50) // APPROVED, PENDING_REVIEW
  manager_user_id        String?        @db.Uuid
  created_at             DateTime       @default(now()) @db.Timestamptz(6)
  updated_at             DateTime       @updatedAt @db.Timestamptz(6)

  // Relationships
  manager                User?          @relation("AcademyManager", fields: [manager_user_id], references: [id], onDelete: SetNull)
  participants           Participant[]
  registrations          Registration[]

  @@index([code])
  @@index([name])
  @@index([city, state])
  @@map("academies")
}

// ------------------------------------------------------------------------------
// 4. CATEGORIES (Discipline, Division & Weight Rules)
// ------------------------------------------------------------------------------
model Category {
  id                 String         @id @default(uuid()) @db.Uuid
  championship_id    String         @db.Uuid
  code               String         @db.VarChar(60) // e.g. KY-SEN-M-U58
  name               String         @db.VarChar(255) // e.g. Senior Male -58kg
  discipline         String         @db.VarChar(50)  // KYORUGI, POOMSAE, DEMO
  division           String         @db.VarChar(50)  // SENIOR, JUNIOR, CADET, SUB_JUNIOR
  gender             Gender
  min_age            Int?
  max_age            Int?
  min_weight         Decimal?       @db.Decimal(5, 2)
  max_weight         Decimal?       @db.Decimal(5, 2)
  belt_requirement   String?        @db.VarChar(100) // e.g. 1ST_DAN_ABOVE, COLOR_BELT, ANY
  registration_fee   Decimal?       @db.Decimal(10, 2)
  max_participants   Int?
  display_order      Int            @default(0)
  is_active          Boolean        @default(true)
  created_at         DateTime       @default(now()) @db.Timestamptz(6)
  updated_at         DateTime       @updatedAt @db.Timestamptz(6)

  // Relationships
  championship       Championship      @relation(fields: [championship_id], references: [id], onDelete: Cascade)
  registrations      Registration[]
  registration_fees  RegistrationFee[]

  @@unique([championship_id, code])
  @@index([championship_id, discipline, division])
  @@index([is_active])
  @@map("categories")
}

// ------------------------------------------------------------------------------
// 5. PARTICIPANTS (Master Participant Profile)
// ------------------------------------------------------------------------------
model Participant {
  id                  String            @id @default(uuid()) @db.Uuid
  user_id             String?           @db.Uuid
  academy_id          String?           @db.Uuid
  public_id           String            @unique @db.VarChar(50) // Non-guessable public ID, e.g. KUKKI-2026-X8F9Q
  full_name           String            @db.VarChar(255)
  date_of_birth       DateTime          @db.Date
  gender              Gender
  nationality         String            @db.VarChar(50) // ISO code or Country Name reference
  designation         String            @db.VarChar(100) // Configurable designation (e.g. Athlete, Coach)
  
  // Academy / Club affiliation
  academy_name        String?           @db.VarChar(255)
  academy_country     String?           @db.VarChar(100)
  academy_state       String?           @db.VarChar(100)
  academy_city        String?           @db.VarChar(100)
  
  // Kukkiwon credentials
  kukkiwon_id         String?           @db.VarChar(100) // Dan/Poom Certificate Number
  
  // Controlled photo access (stored in participant-photos bucket)
  photo_url           String?           @db.Text
  
  // Contact & Status
  email               String?           @db.VarChar(255)
  phone               String?           @db.VarChar(50)
  registration_status ParticipantStatus @default(ACTIVE)
  
  created_at          DateTime          @default(now()) @db.Timestamptz(6)
  updated_at          DateTime          @updatedAt @db.Timestamptz(6)

  // Relationships
  user                User?             @relation(fields: [user_id], references: [id], onDelete: SetNull)
  academy             Academy?          @relation(fields: [academy_id], references: [id], onDelete: SetNull)
  registrations       Registration[]
  documents           Document[]
  id_cards            IdCard[]

  @@index([public_id])
  @@index([full_name])
  @@index([designation])
  @@index([nationality])
  @@map("participants")
}

// ------------------------------------------------------------------------------
// 6. REGISTRATIONS (Championship <-> Participant Linkage)
// ------------------------------------------------------------------------------
model Registration {
  id                  String             @id @default(uuid()) @db.Uuid
  user_id             String?            @db.Uuid
  registration_number String             @unique @db.VarChar(60) // e.g. KKC26-ATH-000001
  athlete_id          String?            @unique @db.VarChar(60) // Persistent unique athlete identifier
  championship_id     String             @db.Uuid
  participant_id      String             @db.Uuid
  participant_type    ParticipantType    @default(ATHLETE)
  status              RegistrationStatus @default(DRAFT)
  
  // Discipline & Category Linkage
  discipline          String?            @db.VarChar(50)  // KYORUGI, POOMSAE, DEMO
  category_id         String?            @db.Uuid
  academy_id          String?            @db.Uuid
  weight_kg           Decimal?           @db.Decimal(5, 2)
  belt_rank           String?            @db.VarChar(100)
  
  // Coach specific
  coach_role          String?            @db.VarChar(100)
  coach_qualification String?            @db.Text

  // Multi-step Draft State (JSON serialized draft for save & resume later)
  draft_data          String?            @db.Text

  registered_at       DateTime           @default(now()) @db.Timestamptz(6)
  submitted_at        DateTime?          @db.Timestamptz(6)
  confirmed_at        DateTime?          @db.Timestamptz(6)
  
  // Legal & Terms compliance tracking
  terms_version       String             @default("v1.0") @db.VarChar(20)
  terms_accepted_at   DateTime           @default(now()) @db.Timestamptz(6)
  
  notes               String?            @db.Text
  created_at          DateTime           @default(now()) @db.Timestamptz(6)
  updated_at          DateTime           @updatedAt @db.Timestamptz(6)

  // Relationships
  user                  User?                 @relation(fields: [user_id], references: [id], onDelete: SetNull)
  championship          Championship          @relation(fields: [championship_id], references: [id], onDelete: Restrict)
  participant           Participant           @relation(fields: [participant_id], references: [id], onDelete: Cascade)
  category              Category?             @relation(fields: [category_id], references: [id], onDelete: SetNull)
  academy               Academy?              @relation(fields: [academy_id], references: [id], onDelete: SetNull)
  payments              Payment[]
  payment_orders        PaymentOrder[]
  invoices              PaymentInvoice[]
  documents             Document[]
  participant_documents ParticipantDocument[]
  id_card               IdCard?

  @@index([user_id])
  @@index([championship_id])
  @@index([participant_id])
  @@index([participant_type])
  @@index([status])
  @@index([registration_number])
  @@map("registrations")
}

// ------------------------------------------------------------------------------
// 7. DESIGNATIONS (Configurable Role Table - Admin Managed)
// ------------------------------------------------------------------------------
model Designation {
  id                   String   @id @default(uuid()) @db.Uuid
  code                 String   @unique @db.VarChar(50) // ATHLETE, COACH, TECHNICAL_OFFICIAL, etc.
  label                String   @db.VarChar(100)
  description          String?  @db.Text
  requires_kukkiwon_id Boolean  @default(false)
  requires_documents   Boolean  @default(false)
  display_order        Int      @default(0)
  is_active            Boolean  @default(true)
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @updatedAt @db.Timestamptz(6)

  @@index([is_active, display_order])
  @@map("designations")
}

// ------------------------------------------------------------------------------
// 8. NATIONALITIES (Standardized Country & Flag Mapping)
// ------------------------------------------------------------------------------
model Nationality {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique @db.VarChar(100) // e.g. "India", "South Korea"
  iso_code        String   @unique @db.VarChar(3)   // e.g. "IND", "KOR"
  iso_alpha2      String   @unique @db.VarChar(2)   // e.g. "IN", "KR"
  flag_identifier String?  @db.VarChar(50)          // Emoji flag (🇮🇳) or svg asset path
  display_order   Int      @default(0)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([iso_code])
  @@index([iso_alpha2])
  @@index([is_active, display_order])
  @@map("nationalities")
}

// ------------------------------------------------------------------------------
// 9. DOCUMENTS (Private Secure Storage for Verification)
// ------------------------------------------------------------------------------
model Document {
  id                  String                     @id @default(uuid()) @db.Uuid
  participant_id      String                     @db.Uuid
  registration_id     String?                    @db.Uuid
  document_type       String                     @db.VarChar(100) // e.g. AADHAAR_PASSPORT, KUKKIWON_CERTIFICATE
  file_path           String                     @db.Text // Private path in participant-documents bucket
  file_name           String                     @db.VarChar(255)
  mime_type           String                     @db.VarChar(100)
  file_size           Int                        // Size in bytes
  verification_status DocumentVerificationStatus @default(PENDING)
  rejection_reason    String?                    @db.Text
  uploaded_at         DateTime                   @default(now()) @db.Timestamptz(6)
  verified_at         DateTime?                  @db.Timestamptz(6)
  verified_by         String?                    @db.Uuid // AdminUser ID who reviewed
  created_at          DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at          DateTime                   @updatedAt @db.Timestamptz(6)

  // Relationships
  participant         Participant                @relation(fields: [participant_id], references: [id], onDelete: Cascade)
  registration        Registration?              @relation(fields: [registration_id], references: [id], onDelete: SetNull)

  @@index([participant_id])
  @@index([registration_id])
  @@index([verification_status])
  @@map("documents")
}

// ------------------------------------------------------------------------------
// 9b. DOCUMENT REQUIREMENTS (Championship Configurable Architecture - Phase 4)
// ------------------------------------------------------------------------------
model DocumentRequirement {
  id                 String                @id @default(uuid()) @db.Uuid
  championship_id    String                @db.Uuid
  participant_type   ParticipantType
  discipline         String?               @db.VarChar(50)
  document_type      String                @db.VarChar(100) // PHOTOGRAPH, GOVERNMENT_ID, PASSPORT, PROOF_OF_AGE, DAN_CERTIFICATE, MEDICAL_CERTIFICATE, etc.
  title              String                @db.VarChar(255)
  description        String?               @db.Text
  is_required        Boolean               @default(true)
  requires_dan       Boolean               @default(false)
  min_age            Int?
  max_age            Int?
  allowed_file_types String                @default("image/jpeg,image/png,application/pdf") @db.VarChar(255)
  max_file_size      Int                   @default(5242880) // 5MB in bytes
  display_order      Int                   @default(0)
  is_active          Boolean               @default(true)
  created_at         DateTime              @default(now()) @db.Timestamptz(6)
  updated_at         DateTime              @updatedAt @db.Timestamptz(6)

  // Relationships
  championship       Championship          @relation(fields: [championship_id], references: [id], onDelete: Cascade)
  documents          ParticipantDocument[]

  @@index([championship_id, participant_type])
  @@index([is_active, display_order])
  @@map("document_requirements")
}

// ------------------------------------------------------------------------------
// 9c. PARTICIPANT DOCUMENTS (Secure, Versioned Document Uploads - Phase 4)
// ------------------------------------------------------------------------------
model ParticipantDocument {
  id                      String                     @id @default(uuid()) @db.Uuid
  registration_id         String                     @db.Uuid
  document_requirement_id String                     @db.Uuid
  original_filename       String                     @db.VarChar(255)
  storage_key             String                     @db.Text
  mime_type               String                     @db.VarChar(100)
  file_size               Int
  checksum                String                     @db.VarChar(64) // SHA-256
  version                 Int                        @default(1)
  is_current              Boolean                    @default(true)
  verification_status     DocumentVerificationStatus @default(UPLOADED)
  rejection_reason        String?                    @db.Text
  uploaded_at             DateTime                   @default(now()) @db.Timestamptz(6)
  verified_at             DateTime?                  @db.Timestamptz(6)
  verified_by             String?                    @db.VarChar(255)
  created_at              DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                   @updatedAt @db.Timestamptz(6)

  // Relationships
  registration            Registration               @relation(fields: [registration_id], references: [id], onDelete: Cascade)
  requirement             DocumentRequirement        @relation(fields: [document_requirement_id], references: [id], onDelete: Cascade)

  @@index([registration_id])
  @@index([document_requirement_id])
  @@index([verification_status])
  @@index([is_current])
  @@map("participant_documents")
}

// ------------------------------------------------------------------------------
// 10. PAYMENTS (Secure Payment Records & Gateway Verification)
// ------------------------------------------------------------------------------
model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  registration_id String        @db.Uuid
  provider        String        @default("RAZORPAY") @db.VarChar(50) // RAZORPAY, STRIPE, MANUAL
  order_id        String?       @db.VarChar(100) // Provider order identifier
  payment_id      String?       @db.VarChar(100) // Provider transaction/payment ID
  signature       String?       @db.Text         // Server verification signature
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("INR") @db.VarChar(10)
  status          PaymentStatus @default(CREATED)
  payment_method  String?       @db.VarChar(50)  // UPI, CARD, NETBANKING
  paid_at         DateTime?     @db.Timestamptz(6)
  receipt_url     String?       @db.Text
  raw_response    String?       @db.Text         // Serialized gateway payload for audit
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @updatedAt @db.Timestamptz(6)

  // Relationships
  registration    Registration  @relation(fields: [registration_id], references: [id], onDelete: Restrict)

  @@index([registration_id])
  @@index([order_id])
  @@index([payment_id])
  @@index([status])
  @@map("payments")
}

// ------------------------------------------------------------------------------
// 10b. REGISTRATION FEES (Configurable Fee Rules - Phase 5)
// ------------------------------------------------------------------------------
model RegistrationFee {
  id               String          @id @default(uuid()) @db.Uuid
  championship_id  String          @db.Uuid
  category_id      String?         @db.Uuid
  participant_type ParticipantType @default(ATHLETE)
  name             String          @db.VarChar(255)
  amount_paise     Int             // Base fee in paise (e.g. 150000 = ₹1,500)
  late_fee_paise   Int             @default(0) // Late fee surcharge in paise
  currency         String          @default("INR") @db.VarChar(10)
  effective_from   DateTime?       @db.Timestamptz(6)
  effective_until  DateTime?       @db.Timestamptz(6)
  late_fee_from    DateTime?       @db.Timestamptz(6)
  is_active        Boolean         @default(true)
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime        @updatedAt @db.Timestamptz(6)

  // Relationships
  championship     Championship    @relation(fields: [championship_id], references: [id], onDelete: Cascade)
  category         Category?       @relation(fields: [category_id], references: [id], onDelete: SetNull)

  @@index([championship_id, participant_type])
  @@index([category_id])
  @@index([is_active])
  @@map("registration_fees")
}

// ------------------------------------------------------------------------------
// 10c. PAYMENT ORDERS (Authoritative Order Lifecycle - Phase 5)
// ------------------------------------------------------------------------------
model PaymentOrder {
  id                String             @id @default(uuid()) @db.Uuid
  order_number      String             @unique @db.VarChar(60) // e.g. KKC26-ORD-000001
  registration_id   String             @db.Uuid
  user_id           String?            @db.Uuid
  provider          String             @default("RAZORPAY") @db.VarChar(50)
  provider_order_id String             @unique @db.VarChar(100) // Razorpay order identifier
  amount_paise      Int                // Total order amount in integer paise
  amount            Decimal            @db.Decimal(10, 2)       // Amount in INR for display
  currency          String             @default("INR") @db.VarChar(10)
  fee_snapshot      String             @db.Text                 // Immutable serialized fee breakdown snapshot
  status            PaymentOrderStatus @default(PENDING)
  created_at        DateTime           @default(now()) @db.Timestamptz(6)
  expires_at        DateTime?          @db.Timestamptz(6)
  paid_at           DateTime?          @db.Timestamptz(6)
  updated_at        DateTime           @updatedAt @db.Timestamptz(6)

  // Relationships
  registration      Registration       @relation(fields: [registration_id], references: [id], onDelete: Restrict)
  user              User?              @relation(fields: [user_id], references: [id], onDelete: SetNull)
  transactions      PaymentTransaction[]
  refunds           PaymentRefund[]
  invoices          PaymentInvoice[]

  @@index([registration_id])
  @@index([user_id])
  @@index([provider_order_id])
  @@index([status])
  @@map("payment_orders")
}

// ------------------------------------------------------------------------------
// 10d. PAYMENT TRANSACTIONS (Cryptographically Verified Gateway Captures - Phase 5)
// ------------------------------------------------------------------------------
model PaymentTransaction {
  id                  String          @id @default(uuid()) @db.Uuid
  payment_order_id    String          @db.Uuid
  provider_payment_id String          @unique @db.VarChar(100) // Razorpay payment identifier
  provider_order_id   String          @db.VarChar(100)
  signature_verified  Boolean         @default(false)
  amount_paise        Int
  amount              Decimal         @db.Decimal(10, 2)
  currency            String          @default("INR") @db.VarChar(10)
  payment_method      String?         @db.VarChar(50)          // upi, card, netbanking
  status              String          @default("CAPTURED") @db.VarChar(50)
  captured_at         DateTime?       @db.Timestamptz(6)
  failure_code        String?         @db.VarChar(100)
  failure_reason      String?         @db.Text
  raw_response        String?         @db.Text                 // Serialized gateway payload
  created_at          DateTime        @default(now()) @db.Timestamptz(6)

  // Relationships
  payment_order       PaymentOrder    @relation(fields: [payment_order_id], references: [id], onDelete: Cascade)
  refunds             PaymentRefund[]

  @@index([payment_order_id])
  @@index([provider_payment_id])
  @@index([provider_order_id])
  @@index([status])
  @@map("payment_transactions")
}

// ------------------------------------------------------------------------------
// 10e. WEBHOOK EVENTS (Idempotent Webhook Processing - Phase 5)
// ------------------------------------------------------------------------------
model PaymentWebhookEvent {
  id                String    @id @default(uuid()) @db.Uuid
  provider          String    @default("RAZORPAY") @db.VarChar(50)
  provider_event_id String    @db.VarChar(100)
  event_type        String    @db.VarChar(100)
  payload_hash      String    @db.VarChar(64) // SHA-256 hash of raw webhook body
  received_at       DateTime  @default(now()) @db.Timestamptz(6)
  processed_at      DateTime? @db.Timestamptz(6)
  processing_status String    @default("PROCESSED") @db.VarChar(50)
  error_message     String?   @db.Text

  @@unique([provider, provider_event_id])
  @@index([provider, event_type])
  @@index([received_at])
  @@map("payment_webhook_events")
}

// ------------------------------------------------------------------------------
// 10f. PAYMENT INVOICES (Official Receipts & Tax Documentation - Phase 5)
// ------------------------------------------------------------------------------
model PaymentInvoice {
  id                  String        @id @default(uuid()) @db.Uuid
  invoice_number      String        @unique @db.VarChar(60) // e.g. KKC26-INV-000001
  registration_id     String        @db.Uuid
  payment_order_id    String?       @db.Uuid
  user_id             String?       @db.Uuid
  participant_name    String        @db.VarChar(255)
  academy_name        String?       @db.VarChar(255)
  championship_name   String        @db.VarChar(255)
  fee_breakdown       String        @db.Text                 // JSON serialized breakdown
  total_amount_paise  Int
  total_amount        Decimal       @db.Decimal(10, 2)
  currency            String        @default("INR") @db.VarChar(10)
  provider            String        @default("RAZORPAY") @db.VarChar(50)
  provider_payment_id String?       @db.VarChar(100)
  payment_date        DateTime      @default(now()) @db.Timestamptz(6)
  invoice_status      String        @default("PAID") @db.VarChar(50)
  receipt_url         String?       @db.Text
  created_at          DateTime      @default(now()) @db.Timestamptz(6)
  updated_at          DateTime      @updatedAt @db.Timestamptz(6)

  // Relationships
  registration        Registration  @relation(fields: [registration_id], references: [id], onDelete: Restrict)
  payment_order       PaymentOrder? @relation(fields: [payment_order_id], references: [id], onDelete: SetNull)
  user                User?         @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([registration_id])
  @@index([payment_order_id])
  @@index([user_id])
  @@index([invoice_number])
  @@map("payment_invoices")
}

// ------------------------------------------------------------------------------
// 10g. PAYMENT REFUNDS (Auditable Administrative Refunds - Phase 5)
// ------------------------------------------------------------------------------
model PaymentRefund {
  id                     String              @id @default(uuid()) @db.Uuid
  payment_order_id       String              @db.Uuid
  payment_transaction_id String?             @db.Uuid
  provider_refund_id     String?             @unique @db.VarChar(100)
  amount_paise           Int
  amount                 Decimal             @db.Decimal(10, 2)
  currency               String              @default("INR") @db.VarChar(10)
  reason                 String              @db.Text
  status                 RefundStatus        @default(PENDING)
  initiated_by           String?             @db.Uuid
  initiated_at           DateTime            @default(now()) @db.Timestamptz(6)
  processed_at           DateTime?           @db.Timestamptz(6)
  error_message          String?             @db.Text

  // Relationships
  payment_order          PaymentOrder        @relation(fields: [payment_order_id], references: [id], onDelete: Cascade)
  payment_transaction    PaymentTransaction? @relation(fields: [payment_transaction_id], references: [id], onDelete: SetNull)

  @@index([payment_order_id])
  @@index([payment_transaction_id])
  @@index([status])
  @@map("payment_refunds")
}

// ------------------------------------------------------------------------------
// 11. ID CARDS (Accreditation & Badge Generation)
// ------------------------------------------------------------------------------
model IdCard {
  id                String       @id @default(uuid()) @db.Uuid
  participant_id    String       @db.Uuid
  registration_id   String       @unique @db.Uuid
  athlete_id        String?      @unique @db.VarChar(60)
  card_number       String       @unique @db.VarChar(60) // e.g. KKC26-ATH-000001
  qr_token          String       @unique @db.VarChar(128) // High-entropy secure cryptographic token
  version           Int          @default(1)
  card_status       IdCardStatus @default(NOT_GENERATED)
  generated_at      DateTime?    @db.Timestamptz(6)
  revoked_at        DateTime?    @db.Timestamptz(6)
  revocation_reason String?      @db.Text
  pdf_path          String?      @db.Text
  created_at        DateTime     @default(now()) @db.Timestamptz(6)
  updated_at        DateTime     @updatedAt @db.Timestamptz(6)

  // Relationships
  participant       Participant  @relation(fields: [participant_id], references: [id], onDelete: Cascade)
  registration      Registration @relation(fields: [registration_id], references: [id], onDelete: Cascade)

  @@index([card_number])
  @@index([athlete_id])
  @@index([qr_token])
  @@index([card_status])
  @@map("id_cards")
}

// ------------------------------------------------------------------------------
// 12. ADMIN USERS (Role-Based Access Control)
// ------------------------------------------------------------------------------
model AdminUser {
  id            String      @id @default(uuid()) @db.Uuid
  email         String      @unique @db.VarChar(255)
  password_hash String      @db.VarChar(255)
  full_name     String      @db.VarChar(255)
  role          AdminRole   @default(VIEWER)
  is_active     Boolean     @default(true)
  last_login_at DateTime?   @db.Timestamptz(6)
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  updated_at    DateTime    @updatedAt @db.Timestamptz(6)

  // Relationships
  audit_logs    AuditLog[]

  @@index([email])
  @@index([role])
  @@map("admin_users")
}

// ------------------------------------------------------------------------------
// 13. AUDIT LOGS (Immutable Traceability of Admin Operations)
// ------------------------------------------------------------------------------
model AuditLog {
  id            String     @id @default(uuid()) @db.Uuid
  admin_user_id String?    @db.Uuid
  user_id       String?    @db.Uuid
  action        String     @db.VarChar(100) // PARTICIPANT_EDITED, PAYMENT_VERIFIED, DOCUMENT_UPLOADED, etc.
  entity_type   String     @db.VarChar(100) // Participant, Registration, Payment, IdCard, ParticipantDocument
  entity_id     String     @db.VarChar(100)
  old_value     String?    @db.Text         // JSON representation before change
  new_value     String?    @db.Text         // JSON representation after change
  ip_address    String?    @db.VarChar(45)
  user_agent    String?    @db.Text
  created_at    DateTime   @default(now()) @db.Timestamptz(6)

  // Relationships
  admin_user    AdminUser? @relation(fields: [admin_user_id], references: [id], onDelete: SetNull)
  user          User?      @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([admin_user_id])
  @@index([user_id])
  @@index([action])
  @@index([entity_type, entity_id])
  @@index([created_at])
  @@map("audit_logs")
}

// ------------------------------------------------------------------------------
// 14. SITE SETTINGS & CONTENT ARCHITECTURE (CMS Model)
// ------------------------------------------------------------------------------
model SiteSetting {
  id               String        @id @default(uuid()) @db.Uuid
  championship_id  String?       @unique @db.Uuid
  title            String        @default("Kukkiwon Cup Championship") @db.VarChar(255)
  subtitle         String?       @default("Presented by Kukkiwon North India & Kyorix Sports Technology") @db.VarChar(255)
  hero_headline    String?       @db.VarChar(255)
  hero_description String?       @db.Text
  about_content    String?       @db.Text
  poster_url       String?       @db.Text
  contact_email    String?       @db.VarChar(255)
  contact_phone    String?       @db.VarChar(50)
  contact_address  String?       @db.Text
  footer_text      String?       @db.Text
  social_links     String?       @db.Text // JSON: { "instagram": "", "facebook": "", "youtube": "" }
  rules_content    String?       @db.Text
  privacy_policy   String?       @db.Text
  is_published     Boolean       @default(true)
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime      @updatedAt @db.Timestamptz(6)

  // Relationships
  championship     Championship? @relation(fields: [championship_id], references: [id], onDelete: Cascade)

  @@map("site_settings")
}

// ------------------------------------------------------------------------------
// 15. TERMS VERSIONS (Auditable Versioning for Legal Terms Acceptance)
// ------------------------------------------------------------------------------
model TermsVersion {
  id              String        @id @default(uuid()) @db.Uuid
  championship_id String?       @db.Uuid
  version         String        @db.VarChar(20) // e.g. "v1.0"
  title           String        @default("Official Championship Registration Terms") @db.VarChar(255)
  content         String        @db.Text
  published_at    DateTime      @default(now()) @db.Timestamptz(6)
  is_active       Boolean       @default(true)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @updatedAt @db.Timestamptz(6)

  // Relationships
  championship    Championship? @relation(fields: [championship_id], references: [id], onDelete: Cascade)

  @@unique([championship_id, version])
  @@index([version])
  @@index([is_active])
  @@map("terms_versions")
}

// ------------------------------------------------------------------------------
// 16. CHAMPIONSHIP CMS CONTENT & LIVE PUBLISHING ARCHITECTURE (Phase 9)
// ------------------------------------------------------------------------------

model ChampionshipContent {
  id                        String         @id @default(uuid()) @db.Uuid
  championship_id           String         @unique @db.Uuid
  hero_title                String         @db.VarChar(255)
  hero_subtitle             String?        @db.VarChar(255)
  description               String?        @db.Text
  venue                     String?        @db.VarChar(255)
  location                  String?        @db.VarChar(255)
  registration_instructions String?        @db.Text
  contact_email             String?        @db.VarChar(255)
  contact_phone             String?        @db.VarChar(50)
  website_status            String         @default("DRAFT") @db.VarChar(50) // DRAFT, PUBLISHED, ARCHIVED
  created_at                DateTime       @default(now()) @db.Timestamptz(6)
  updated_at                DateTime       @updatedAt @db.Timestamptz(6)
  published_at              DateTime?      @db.Timestamptz(6)
  updated_by                String?        @db.VarChar(255)

  // Relationships
  championship              Championship   @relation(fields: [championship_id], references: [id], onDelete: Cascade)

  @@index([website_status])
  @@map("championship_contents")
}

model ChampionshipAnnouncement {
  id              String        @id @default(uuid()) @db.Uuid
  championship_id String        @db.Uuid
  title           String        @db.VarChar(255)
  content         String        @db.Text
  priority        Int           @default(0) // Higher number = higher priority
  is_published    Boolean       @default(false)
  published_at    DateTime?     @db.Timestamptz(6)
  expires_at      DateTime?     @db.Timestamptz(6)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @updatedAt @db.Timestamptz(6)
  created_by      String?       @db.VarChar(255)

  // Relationships
  championship    Championship  @relation(fields: [championship_id], references: [id], onDelete: Cascade)

  @@index([championship_id, is_published])
  @@index([priority, published_at])
  @@map("championship_announcements")
}

model ChampionshipImportantDate {
  id              String        @id @default(uuid()) @db.Uuid
  championship_id String        @db.Uuid
  title           String        @db.VarChar(255)
  description     String?       @db.Text
  date            DateTime      @db.Timestamptz(6)
  display_order   Int           @default(0)
  is_published    Boolean       @default(true)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @updatedAt @db.Timestamptz(6)

  // Relationships
  championship    Championship  @relation(fields: [championship_id], references: [id], onDelete: Cascade)

  @@index([championship_id, is_published, display_order])
  @@map("championship_important_dates")
}

model ChampionshipFAQ {
  id              String        @id @default(uuid()) @db.Uuid
  championship_id String        @db.Uuid
  question        String        @db.Text
  answer          String        @db.Text
  display_order   Int           @default(0)
  is_published    Boolean       @default(true)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @updatedAt @db.Timestamptz(6)

  // Relationships
  championship    Championship  @relation(fields: [championship_id], references: [id], onDelete: Cascade)

  @@index([championship_id, is_published, display_order])
  @@map("championship_faqs")
}
